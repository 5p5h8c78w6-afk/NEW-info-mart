+function cloudDefault(){
+  return {
+    projectUrl:"",
+    publicKey:"",
+    session:null,
+    orgId:"",
+    orgName:"",
+    role:"",
+    storeId:"",
+    storeName:"",
+    displayName:"",
+    directoryName:"",
+    userCode:"",
+    stores:[],
+    members:[],
+    lastMasterVersion:0,
+    remoteMasterVersion:0,
+    remoteMasterUpdatedAt:"",
+    lastSyncAt:"",
+    lastContextAt:""
+  };
+}
+function normalizeCloud(x){
+  x=x&&typeof x==="object"?x:{};
+  const d=cloudDefault();
+  return {
+    ...d,...x,
+    projectUrl:String(x.projectUrl||""),
+    publicKey:String(x.publicKey||""),
+    session:x.session&&typeof x.session==="object"?x.session:null,
+    stores:Array.isArray(x.stores)?x.stores:[],
+    members:Array.isArray(x.members)?x.members:[]
+  };
+}
+function cloudConfigured(){
+  const c=ROOT.cloud||cloudDefault();
+  return /^https:\/\/.+/i.test(c.projectUrl||"")&&String(c.publicKey||"").length>=20;
+}
+function cloudLoggedIn(){return !!ROOT.cloud?.session?.access_token}
+function cloudRoleLabel(r){return ({owner:"オーナー",admin:"管理者",manager:"店長",orderer:"発注担当",viewer:"閲覧のみ"})[r]||r||"未設定"}
+function cloudIsAdminRole(){return ["owner","admin"].includes(ROOT.cloud?.role||"")}
+function cloudStoreName(id){return (ROOT.cloud?.stores||[]).find(s=>s.id===id)?.name||""}
+function cloudSanitizeProjectUrl(s){return String(s||"").trim().replace(/\/+$/,"")}
+function cloudPublicKeyIsSafe(key){
+  const k=String(key||"").trim();
+  if(/^sb_secret_/i.test(k)||/service[_-]?role/i.test(k))return false;
+  if(/^sb_publishable_/i.test(k))return true;
+  if(k.startsWith("eyJ")){
+    try{
