+function catalogStatusInfo(p){
+  if(p.catalogStatus==="listed")return {label:"掲載確認済み",cls:"ok"};
+  if(p.catalogStatus==="not-listed-candidate")return {label:"掲載なし候補",cls:"warn"};
+  if(p.imageSource&&!p.domSource)return {label:"画像仮登録",cls:"warn"};
+  if(p.domSource)return {label:"DOM登録済み",cls:"neutral"};
+  return {label:"掲載未確認",cls:"neutral"};
+}
+function catalogMasterCounts(){
+  const ps=ROOT.commonMaster.products||[];
+  return {
+    total:ps.length,
+    listed:ps.filter(p=>p.catalogStatus==="listed").length,
+    missing:ps.filter(p=>p.catalogStatus==="not-listed-candidate").length,
+    unchecked:ps.filter(p=>!p.catalogStatus).length
+  };
+}
