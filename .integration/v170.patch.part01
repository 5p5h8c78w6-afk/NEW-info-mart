 let CALENDAR_MONTH=iso(today()).slice(0,7);
 let CALENDAR_FILTER="all";
 let CALENDAR_TRADE_STORE="all";
-
+const CLOUD_SETUP_SQL="-- Infomart 発注ナビ v1.7.0\n-- Supabase Free / Cloud Foundation Setup\n-- Supabase Dashboard > SQL Editor でこのSQLを1回だけ実行してください。\n-- 発注ナビへ入力するのは Project URL と Publishable key だけです。\n-- Secret key / service_role key はブラウザへ置かないでください。\n\ncreate extension if not exists pgcrypto;\ncreate schema if not exists private;\n\ncreate table if not exists public.user_directory (\n  user_id uuid primary key references auth.users(id) on delete cascade,\n  display_name text not null check (char_length(btrim(display_name)) between 1 and 80),\n  join_code text not null unique check (char_length(join_code) between 8 and 16),\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now()\n);\n\ncreate table if not exists public.organizations (\n  id uuid primary key default gen_random_uuid(),\n  name text not null check (char_length(btrim(name)) between 1 and 100),\n  created_by uuid not null references auth.users(id) on delete restrict,\n  created_at timestamptz not null default now()\n);\n\ncreate table if not exists public.stores (\n  id uuid primary key default gen_random_uuid(),\n  org_id uuid not null references public.organizations(id) on delete cascade,\n  name text not null check (char_length(btrim(name)) between 1 and 100),\n  active boolean not null default true,\n  created_at timestamptz not null default now(),\n  unique(org_id, name)\n);\n\ncreate table if not exists public.org_members (\n  org_id uuid not null references public.organizations(id) on delete cascade,\n  user_id uuid not null references auth.users(id) on delete cascade,\n  role text not null check (role in ('owner','admin','manager','orderer','viewer')),\n  store_id uuid references public.stores(id) on delete set null,\n  display_name text not null check (char_length(btrim(display_name)) between 1 and 80),\n  joined_at timestamptz not null default now(),\n  updated_at timestamptz not null default now(),\n  primary key(org_id, user_id),\n  unique(user_id)\n);\n\ncreate table if not exists public.shared_master (\n  org_id uuid primary key references public.organizations(id) on delete cascade,\n  master_version bigint not null default 0 check (master_version >= 0),\n  payload jsonb not null,\n  updated_at timestamptz not null default now(),\n  updated_by uuid not null references auth.users(id) on delete restrict\n);\n\ncreate table if not exists public.cloud_audit (\n  id bigint generated by default as identity primary key,\n  org_id uuid not null references public.organizations(id) on delete cascade,\n  user_id uuid not null references auth.users(id) on delete restrict,\n  action text not null,\n  entity_type text not null,\n  entity_key text,\n  detail jsonb not null default '{}'::jsonb,\n  created_at timestamptz not null default now()\n);\n\ncreate index if not exists idx_stores_org on public.stores(org_id);\ncreate index if not exists idx_members_org on public.org_members(org_id);\ncreate index if not exists idx_directory_code on public.user_directory(join_code);\ncreate index if not exists idx_audit_org_time on public.cloud_audit(org_id, created_at desc);\n\n-- RLSからだけ呼ぶ権限判定。private schemaはData APIの公開対象にしません。\ncreate or replace function private.is_org_member(p_org uuid)\nreturns boolean\nlanguage sql\nstable\nsecurity definer\nset search_path = ''\nas $$\n  select exists(\n    select 1 from public.org_members m\n    where m.org_id = p_org and m.user_id = (select auth.uid())\n  );\n$$;\n\ncreate or replace function private.is_org_admin(p_org uuid)\nreturns boolean\nlanguage sql\nstable\nsecurity definer\nset search_path = ''\nas $$\n  select exists(\n    select 1 from public.org_members m\n    where m.org_id = p_org\n      and m.user_id = (select auth.uid())\n      and m.role in ('owner','admin')\n  );\n$$;\n\ncreate or replace function private.is_org_owner(p_org uuid)\nreturns boolean\nlanguage sql\nstable\nsecurity definer\nset search_path = ''\nas $$\n  select exists(\n    select 1 from public.org_members m\n    where m.org_id = p_org\n      and m.user_id = (select auth.uid())\n      and m.role = 'owner'\n  );\n$$;\n\ncreate or replace function private.is_any_admin()\nreturns boolean\nlanguage sql\nstable\nsecurity definer\nset search_path = ''\nas $$\n  select exists(\n    select 1 from public.org_members m\n    where m.user_id = (select auth.uid())\n      and m.role in ('owner','admin')\n  );\n$$;\n\n-- 最後のownerを誤って降格させない\ncreate or replace function private.guard_last_owner()\nreturns trigger\nlanguage plpgsql\nsecurity definer\nset search_path = ''\nas $$\ndeclare\n  v_count integer;\nbegin\n  if old.role='owner' and new.role<>'owner' then\n    select count(*) into v_count\n    from public.org_members m\n    where m.org_id=old.org_id and m.role='owner' and m.user_id<>old.user_id;\n    if v_count=0 then\n      raise exception 'last_owner_cannot_be_demoted';\n    end if;\n  end if;\n  return new;\nend;\n$$;\n\ndrop trigger if exists trg_guard_last_owner on public.org_members;\ncreate trigger trg_guard_last_owner\nbefore update on public.org_members\nfor each row execute function private.guard_last_owner();\n\n-- 所属店舗が同じ会社に属することをDB側でも検証\ncreate or replace function private.guard_member_store()\nreturns trigger\nlanguage plpgsql\nsecurity definer\nset search_path = ''\nas $$\nbegin\n  if new.store_id is not null and not exists(\n    select 1 from public.stores s\n    where s.id=new.store_id and s.org_id=new.org_id and s.active=true\n  ) then\n    raise exception 'invalid_store';\n  end if;\n  return new;\nend;\n$$;\n\ndrop trigger if exists trg_guard_member_store on public.org_members;\ncreate trigger trg_guard_member_store\nbefore insert or update on public.org_members\nfor each row execute function private.guard_member_store();\n\nalter table public.user_directory enable row level security;\nalter table public.organizations enable row level security;\nalter table public.stores enable row level security;\nalter table public.org_members enable row level security;\nalter table public.shared_master enable row level security;\nalter table public.cloud_audit enable row level security;\n\n-- 先に既定権限を外してから必要な操作だけ付与\nrevoke all on public.user_directory, public.organizations, public.stores,\n  public.org_members, public.shared_master, public.cloud_audit from anon, authenticated;\n\ngrant usage on schema public to authenticated;\ngrant select, insert, update on public.user_directory to authenticated;\ngrant select, insert, update on public.organizations to authenticated;\ngrant select, insert, update on public.stores to authenticated;\ngrant select, insert, update on public.org_members to authenticated;\ngrant select, insert, update on public.shared_master to authenticated;\ngrant select, insert on public.cloud_audit to authenticated;\ngrant usage, select on sequence public.cloud_audit_id_seq to authenticated;\n\nrevoke all on schema private from public;\ngrant usage on schema private to authenticated;\nrevoke all on function private.guard_last_owner() from public;\nrevoke all on function private.guard_member_store() from public;\nrevoke all on function private.is_org_member(uuid) from public;\nrevoke all on function private.is_org_admin(uuid) from public;\nrevoke all on function private.is_org_owner(uuid) from public;\nrevoke all on function private.is_any_admin() from public;\ngrant execute on function private.is_org_member(uuid) to authenticated;\ngrant execute on function private.is_org_admin(uuid) to authenticated;\ngrant execute on function private.is_org_owner(uuid) to authenticated;\ngrant execute on function private.is_any_admin() to authenticated;\n\n-- user_directory: 本人は自分、管理者は新規利用者を登録コードで検索可能\ndrop policy if exists directory_select on public.user_directory;\ncreate policy directory_select on public.user_directory\nfor select to authenticated\nusing (user_id=(select auth.uid()) or (select private.is_any_admin()));\n\ndrop policy if exists directory_insert_self on public.user_directory;\ncreate policy directory_insert_self on public.user_directory\nfor insert to authenticated\nwith check (user_id=(select auth.uid()));\n\ndrop policy if exists directory_update_self on public.user_directory;\ncreate policy directory_update_self on public.user_directory\nfor update to authenticated\nusing (user_id=(select auth.uid()))\nwith check (user_id=(select auth.uid()));\n\n-- organizations\ndrop policy if exists org_select on public.organizations;\ncreate policy org_select on public.organizations\nfor select to authenticated\nusing ((select private.is_org_member(id)) or created_by=(select auth.uid()));\n\ndrop policy if exists org_insert_self on public.organizations;\ncreate policy org_insert_self on public.organizations\nfor insert to authenticated\nwith check (created_by=(select auth.uid()));\n\ndrop policy if exists org_update_admin on public.organizations;\ncreate policy org_update_admin on public.organizations\nfor update to authenticated\nusing ((select private.is_org_admin(id)))\nwith check ((select private.is_org_admin(id)));\n\n-- stores\ndrop policy if exists stores_select on public.stores;\ncreate policy stores_select on public.stores\nfor select to authenticated\nusing (\n  (select private.is_org_member(org_id))\n  or exists(select 1 from public.organizations o where o.id=org_id and o.created_by=(select auth.uid()))\n);\n\ndrop policy if exists stores_insert_admin on public.stores;\ncreate policy stores_insert_admin on public.stores\nfor insert to authenticated\nwith check (\n  (select private.is_org_admin(org_id))\n  or exists(select 1 from public.organizations o where o.id=org_id and o.created_by=(select auth.uid()))\n);\n\ndrop policy if exists stores_update_admin on public.stores;\ncreate policy stores_update_admin on public.stores\nfor update to authenticated\nusing ((select private.is_org_admin(org_id)))\nwith check ((select private.is_org_admin(org_id)));\n\n-- org_members\ndrop policy if exists members_select on public.org_members;\ncreate policy members_select on public.org_members\nfor select to authenticated\nusing (\n  user_id=(select auth.uid())\n  or (select private.is_org_member(org_id))\n  or exists(select 1 from public.organizations o where o.id=org_id and o.created_by=(select auth.uid()))\n);\n\ndrop policy if exists members_insert on public.org_members;\ncreate policy members_insert on public.org_members\nfor insert to authenticated\nwith check (\n  (\n    user_id=(select auth.uid())\n    and role='owner'\n    and exists(select 1 from public.organizations o where o.id=org_id and o.created_by=(select auth.uid()))\n  )\n  or (\n    role='owner' and (select private.is_org_owner(org_id))\n  )\n  or (\n    role<>'owner' and (select private.is_org_admin(org_id))\n  )\n);\n\ndrop policy if exists members_update on public.org_members;\ncreate policy members_update on public.org_members\nfor update to authenticated\nusing (\n  (select private.is_org_owner(org_id))\n  or ((select private.is_org_admin(org_id)) and role<>'owner')\n)\nwith check (\n  (role='owner' and (select private.is_org_owner(org_id)))\n  or (role<>'owner' and (select private.is_org_admin(org_id)))\n);\n\n-- shared master: 読取=会社メンバー、書込=owner/admin\ndrop policy if exists master_select on public.shared_master;\ncreate policy master_select on public.shared_master\nfor select to authenticated\nusing ((select private.is_org_member(org_id)));\n\ndrop policy if exists master_insert_admin on public.shared_master;\ncreate policy master_insert_admin on public.shared_master\nfor insert to authenticated\nwith check ((select private.is_org_admin(org_id)));\n\ndrop policy if exists master_update_admin on public.shared_master;\ncreate policy master_update_admin on public.shared_master\nfor update to authenticated\nusing ((select private.is_org_admin(org_id)))\nwith check ((select private.is_org_admin(org_id)));\n\n-- audit: 自分の操作だけ追記可、閲覧はowner/admin\ndrop policy if exists audit_select_admin on public.cloud_audit;\ncreate policy audit_select_admin on public.cloud_audit\nfor select to authenticated\nusing ((select private.is_org_admin(org_id)));\n\ndrop policy if exists audit_insert_member on public.cloud_audit;\ncreate policy audit_insert_member on public.cloud_audit\nfor insert to authenticated\nwith check (\n  user_id=(select auth.uid())\n  and (select private.is_org_member(org_id))\n);\n";
 const $=(s,r=document)=>r.querySelector(s);
 const $$=(s,r=document)=>Array.from(r.querySelectorAll(s));
 const uid=()=>crypto.randomUUID?.()||Date.now().toString(36)+Math.random().toString(36).slice(2);
