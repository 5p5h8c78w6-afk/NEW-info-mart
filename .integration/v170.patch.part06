+
+function catalogNorm(v){return String(v??"").replace(/\s+/g," ").trim()}
+function catalogComparableRow(r){return {name:catalogNorm(r?.name),specification:catalogNorm(r?.specification),vendorDisplay:catalogNorm(r?.vendorDisplay)}}
+function catalogRowChanged(p,row){
+  const a=catalogComparableRow(p.domSource||p),b=catalogComparableRow(row);
+  return ["name","specification","vendorDisplay"].some(k=>a[k]!==b[k]);
+}
+function catalogDiffBuild(entries,{fullScan=false}={}){
+  const byCode=new Map(),conflicts=[];
+  for(const e of entries){
+    if(e.error){conflicts.push({code:e.row?.code||"",reason:e.error,row:e.row});continue}
+    const r=e.row;try{validateDomRow(r)}catch(err){conflicts.push({code:r?.code||"",reason:err.message,row:r});continue}
+    const prev=byCode.get(r.code);
+    if(!prev){byCode.set(r.code,r);continue}
+    const keys=["name","specification","priceDisplay","unitDisplay","vendorDisplay"];
+    if(keys.some(k=>catalogNorm(prev[k])!==catalogNorm(r[k]))){conflicts.push({code:r.code,reason:"複数JSONで同じ商品コードの表示内容が一致しません",row:r});byCode.delete(r.code)}
+  }
+  const fresh=[...byCode.values()],masterByCode=new Map((ROOT.commonMaster.products||[]).map(p=>[String(p.code),p]));
+  const added=[],changed=[],unchanged=[];
+  for(const row of fresh){const p=masterByCode.get(row.code);if(!p)added.push({row});else if(catalogRowChanged(p,row))changed.push({p,row});else unchanged.push({p,row})}
+  const missing=fullScan?(ROOT.commonMaster.products||[]).filter(p=>!byCode.has(String(p.code))):[];
+  return {added,changed,unchanged,missing,conflicts,seenCodes:new Set(fresh.map(r=>r.code))};
+}
+function catalogChangeFields(p,row){
+  const cur=catalogComparableRow(p.domSource||p),next=catalogComparableRow(row),out=[];
+  if(cur.name!==next.name)out.push(["商品名",cur.name,next.name]);
+  if(cur.specification!==next.specification)out.push(["規格",cur.specification,next.specification]);
+  if(cur.vendorDisplay!==next.vendorDisplay)out.push(["Infomart発注先表示",cur.vendorDisplay,next.vendorDisplay]);
+  return out;
+}
+async function catalogDiffFilesSelected(fileList){
+  const files=[...(fileList||[])];const input=$("#catalogDiffFiles");if(input)input.value="";if(!files.length)return;
+  try{
+    const entries=[],reports=[];
+    for(const f of files){
+      if(f.size>15*1024*1024)throw Error(`${f.name}：ファイルが大きすぎます`);
+      const pkg=JSON.parse(await f.text()),rows=readDomPackage(pkg);entries.push(...rows);reports.push(`${f.name}：${rows.filter(x=>!x.error).length}行 / 除外 ${rows.filter(x=>x.error).length+(pkg.failures||[]).length}行`)
+    }
+    catalogDiffDialog(entries,reports);
+  }catch(err){alert("差分チェックできません："+err.message)}
+}
+function catalogDiffDialog(entries,reports){
+  const profileId=ACTIVE_ID;
+  modal(`<h2>Infomart商品一覧との差分チェック</h2><p>${esc(reports.join(" ／ "))}</p><div class="notice"><strong>安全ルール：</strong>商品は自動追加・自動更新・自動削除しません。新商品と内容変更は、チェックした行だけ反映します。</div><label class="catalog-fullscan-check"><input id="catalogFullScan" type="checkbox"> <strong>今回選んだJSONは、Infomart商品一覧の全ページ分です</strong><span>これをONにした場合だけ「掲載なし候補」を判定します。1ページでも抜けている場合はONにしないでください。</span></label><div id="catalogDiffBody"></div><div class="catalog-diff-sticky"><strong id="catalogDiffSelected">反映選択 0件</strong><button class="btn" id="catalogDiffApply">選択した新規・変更を反映し、確認結果を保存</button></div>`);
+  $("#modal").classList.add("ifm-wide");$("#modal").addEventListener("close",()=>$("#modal").classList.remove("ifm-wide"),{once:true});
+  let diff;
+  function renderDiff(){
+    diff=catalogDiffBuild(entries,{fullScan:$("#catalogFullScan").checked});
+    const body=$("#catalogDiffBody");
+    body.innerHTML=`<div class="catalog-diff-summary"><div class="new"><strong>${diff.added.length}</strong><span>新商品</span></div><div class="change"><strong>${diff.changed.length}</strong><span>内容変更</span></div><div class="same"><strong>${diff.unchanged.length}</strong><span>登録済み</span></div><div class="missing"><strong>${diff.missing.length}</strong><span>掲載なし候補</span></div><div class="conflict"><strong>${diff.conflicts.length}</strong><span>要確認</span></div></div>`;
+    if(diff.conflicts.length)body.insertAdjacentHTML("beforeend",`<section class="card catalog-conflict"><h3>要確認（自動反映しません）</h3>${diff.conflicts.map(x=>`<p><strong>${esc(x.code||"コード不明")}</strong>：${esc(x.reason)}</p>`).join("")}</section>`);
+    if(diff.added.length)body.insertAdjacentHTML("beforeend",`<div class="section">新商品</div>${diff.added.map((x,i)=>`<section class="card catalog-diff-card"><label class="check"><input type="checkbox" data-cdiff-new="${i}"> <strong>${esc(x.row.name)}</strong> <span class="catalog-status ok">新規</span></label><div class="muted">${esc(x.row.code)}</div><p><strong>規格：</strong>${esc(x.row.specification||"未取得")}</p><p><strong>Infomart表示：</strong>${esc(x.row.vendorDisplay)}</p><label class="field">発注先マスター<select data-cdiff-vendor="new-${i}">${vendorOptions()}</select></label></section>`).join("")}`);
+    if(diff.changed.length)body.insertAdjacentHTML("beforeend",`<div class="section">内容変更あり</div>${diff.changed.map((x,i)=>`<section class="card catalog-diff-card"><label class="check"><input type="checkbox" data-cdiff-change="${i}"> <strong>${esc(x.p.name||x.p.code)}</strong> <span class="catalog-status warn">変更あり</span></label><div class="muted">${esc(x.p.code)}</div>${catalogChangeFields(x.p,x.row).map(f=>`<div class="catalog-change-row"><b>${esc(f[0])}</b><span class="before">現在：${esc(f[1]||"（空）")}</span><span class="after">Infomart：${esc(f[2]||"（空）")}</span></div>`).join("")}<label class="field">発注先マスター<select data-cdiff-vendor="change-${i}">${ROOT.commonMaster.vendors.map(v=>`<option value="${esc(v.id)}" ${v.id===x.p.vendorId?"selected":""}>${esc(v.name)}</option>`).join("")}</select></label><p class="muted">数量・発注間隔・プリセットは変更しません。</p></section>`).join("")}`);
+    if(diff.unchanged.length)body.insertAdjacentHTML("beforeend",`<details class="card catalog-same"><summary>登録済み・変更なし ${diff.unchanged.length}件</summary><div class="catalog-code-list">${diff.unchanged.map(x=>`<span>${esc(x.row.code)} ${esc(x.row.name)}</span>`).join("")}</div></details>`);
+    if(diff.missing.length)body.insertAdjacentHTML("beforeend",`<section class="card catalog-missing"><h3>掲載なし候補 ${diff.missing.length}件</h3><div class="error"><strong>削除しません。</strong> 全ページ分として確認したJSONに商品コードが無かったものだけ候補表示します。</div>${diff.missing.map(p=>`<p><strong>${esc(p.code)}</strong> ${esc(p.name||"")} / ${esc(V(p.vendorId)?.name||"発注先未設定")}</p>`).join("")}</section>`);
+    bindDiffChecks();
+  }
+  function bindDiffChecks(){
