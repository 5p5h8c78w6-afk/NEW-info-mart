 self.addEventListener("activate",e=>e.waitUntil(caches.keys().then(keys=>Promise.all(keys.filter(k=>k.startsWith("infomart-order-nav-")&&k!==C).map(k=>caches.delete(k)))).then(()=>self.clients.claim())));
