+
+
+/* v1.6.4 base product master / catalog diff */
+.base-master-card{border:2px solid #b8d3f1;background:linear-gradient(180deg,#fbfdff,#f4f9ff)}
+.base-master-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.base-master-head h2{margin:0 0 6px}
+.base-master-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0}.base-master-stats>div{background:#fff;border:1px solid #d5e4f3;border-radius:14px;padding:12px;text-align:center}.base-master-stats strong{display:block;font-size:24px;color:#144b86}.base-master-stats span{font-size:12px;color:#60758a;font-weight:800}
+.product-master-title{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.product-master-title h3{margin-top:0}
+.catalog-status{display:inline-flex;align-items:center;border-radius:999px;padding:5px 9px;font-size:12px;font-weight:900;white-space:nowrap;background:#e9eef4;color:#52677d}.catalog-status.ok{background:#def7e7;color:#146c3a}.catalog-status.warn{background:#fff0d7;color:#9a5a00}.catalog-status.neutral{background:#edf2f7;color:#5c6d7e}.catalog-last-seen{font-size:12px;color:#60758a}
+.catalog-fullscan-check{display:block;border:2px solid #efc36b;background:#fff9eb;border-radius:14px;padding:12px;margin:12px 0;font-weight:800}.catalog-fullscan-check input{width:auto}.catalog-fullscan-check span{display:block;margin:5px 0 0 26px;color:#765b22;font-size:13px;font-weight:700}
+.catalog-diff-summary{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:14px 0}.catalog-diff-summary>div{border-radius:14px;padding:11px;text-align:center;border:1px solid #dbe4ed;background:#fff}.catalog-diff-summary strong{display:block;font-size:24px}.catalog-diff-summary span{font-size:12px;font-weight:900}.catalog-diff-summary .new strong{color:#147a42}.catalog-diff-summary .change strong,.catalog-diff-summary .missing strong{color:#a96400}.catalog-diff-summary .conflict strong{color:#b42318}
+.catalog-diff-card{box-shadow:none;border:1px solid #ccd9e6}.catalog-change-row{display:grid;grid-template-columns:130px 1fr 1fr;gap:8px;padding:8px 0;border-top:1px solid #e4ebf2}.catalog-change-row .before{background:#f5f7fa;padding:7px;border-radius:8px}.catalog-change-row .after{background:#eef8ff;padding:7px;border-radius:8px}.catalog-conflict{border:2px solid #e36a5c}.catalog-missing{border:2px solid #efc36b}.catalog-code-list{display:grid;gap:5px;margin-top:10px;font-size:13px}.catalog-diff-sticky{position:sticky;bottom:0;z-index:7;display:flex;justify-content:space-between;gap:10px;align-items:center;background:#f5f9ff;border:2px solid #a9c9ee;border-radius:14px;padding:10px;box-shadow:0 -5px 18px #102a4318}
+@media(max-width:760px){.base-master-stats{grid-template-columns:repeat(2,1fr)}.catalog-diff-summary{grid-template-columns:repeat(2,1fr)}.catalog-change-row{grid-template-columns:1fr}.catalog-diff-sticky{display:grid;grid-template-columns:1fr}.catalog-diff-sticky>*{width:100%}}
+
+
+/* v1.7.0 Cloud Free Foundation */
+.cloud-free-card{border:2px solid #b9d8ff;background:linear-gradient(180deg,#f7fbff,#ffffff)}
+.cloud-steps{padding-left:22px;line-height:1.8}
+.cloud-link{text-decoration:none;text-align:center;display:flex;align-items:center;justify-content:center}
+.cloud-split{display:grid;grid-template-columns:1fr 1fr;gap:14px}
+.cloud-split>div{border:1px solid #d9e5f3;border-radius:14px;padding:14px;background:#fbfdff}
+.cloud-org-grid,.cloud-version-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:10px 0 14px}
+.cloud-org-grid>div,.cloud-version-grid>div{border:1px solid #d8e4f1;border-radius:12px;padding:11px;background:#f8fbff}
+.cloud-org-grid span,.cloud-version-grid span{display:block;color:#6b7d90;font-size:13px;margin-bottom:4px}
+.cloud-org-grid strong,.cloud-version-grid strong{display:block;color:#183f70;overflow-wrap:anywhere}
+.cloud-member-list{display:grid;gap:8px}
+.cloud-member-row{display:flex;align-items:center;justify-content:space-between;gap:10px;border:1px solid #dfe7ef;border-radius:12px;padding:11px 12px;background:#fff}
+.cloud-invite-code{font-size:32px;font-weight:900;letter-spacing:.08em;text-align:center;padding:18px;border:2px dashed #66a2e8;border-radius:14px;background:#f5faff;color:#164d8c;margin:10px 0 14px}
+@media(max-width:760px){
+  .cloud-split{grid-template-columns:1fr}
+  .cloud-org-grid,.cloud-version-grid{grid-template-columns:1fr 1fr}
+  .cloud-member-row{align-items:flex-start}
+}
+@media(max-width:420px){
+  .cloud-org-grid,.cloud-version-grid{grid-template-columns:1fr}
+  .cloud-invite-code{font-size:27px}
+}
