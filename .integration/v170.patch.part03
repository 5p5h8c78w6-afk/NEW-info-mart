+      const part=k.split(".")[1]||"",b64=part.replace(/-/g,"+").replace(/_/g,"/")+"=".repeat((4-part.length%4)%4);
+      const payload=JSON.parse(atob(b64));
+      return payload?.role==="anon";
+    }catch(_){return false}
+  }
+  return false;
+}
+function cloudErrorMessage(err){
+  const raw=String(err?.message||err||"");
+  const map=[
+    ["Invalid login credentials","メールアドレスまたはパスワードが違います。"],
+    ["Email not confirmed","確認メールのリンクを開いてからログインしてください。"],
+    ["User already registered","このメールアドレスは登録済みです。ログインしてください。"],
+    ["duplicate key value violates unique constraint \"org_members_user_id_key\"","このアカウントはすでに会社へ登録されています。"],
+    ["duplicate key value violates unique constraint \"user_directory_join_code_key\"","登録コードが重複しました。もう一度実行してください。"],
+    ["duplicate key value violates unique constraint \"shared_master_pkey\"","クラウド側が先に更新されました。最新版を確認してください。"],
+    ["version_conflict","クラウド側が更新されています。先に「クラウドから取得」を実行してください。"],
+    ["last_owner_cannot_be_demoted","最後のオーナーは権限変更できません。"],
+    ["invalid_store","所属店舗が正しくありません。"],
+    ["new row violates row-level security policy","権限がないためクラウド側で拒否されました。"],
+    ["permission denied","クラウド権限が不足しています。"]
+  ];
+  for(const [k,v] of map)if(raw.includes(k))return v;
+  return raw.replace(/^HTTP\s+\d+\s*:\s*/,"")||"クラウド処理に失敗しました。";
+}
+async function cloudAuthRaw(path,body){
+  if(!cloudConfigured())throw new Error("Supabase設定が未完了です。");
+  const c=ROOT.cloud,url=cloudSanitizeProjectUrl(c.projectUrl)+path;
+  const r=await fetch(url,{method:"POST",headers:{"apikey":c.publicKey,"Content-Type":"application/json"},body:JSON.stringify(body||{})});
+  const txt=await r.text();let data=null;try{data=txt?JSON.parse(txt):null}catch{data=txt}
+  if(!r.ok)throw new Error(data?.message||data?.error_description||data?.error||data?.details||`HTTP ${r.status}: ${txt.slice(0,240)}`);
+  return data;
+}
+function cloudStoreSession(data){
+  if(!data?.access_token)return false;
+  ROOT.cloud.session={
+    access_token:data.access_token,
+    refresh_token:data.refresh_token||"",
+    expires_at:+data.expires_at||Math.floor(Date.now()/1000)+(+data.expires_in||3600),
+    user:data.user||ROOT.cloud.session?.user||null
+  };
+  persistRoot();
+  return true;
+}
+async function cloudEnsureFreshSession(){
+  if(!cloudLoggedIn())throw new Error("クラウドへログインしてください。");
+  const s=ROOT.cloud.session,now=Math.floor(Date.now()/1000);
+  if((+s.expires_at||0)>now+90)return s;
+  if(!s.refresh_token){ROOT.cloud.session=null;persistRoot();throw new Error("セッションの期限が切れました。再ログインしてください。")}
+  try{
+    const data=await cloudAuthRaw("/auth/v1/token?grant_type=refresh_token",{refresh_token:s.refresh_token});
+    cloudStoreSession(data);return ROOT.cloud.session;
+  }catch(e){
+    ROOT.cloud.session=null;ROOT.cloud.role="";ROOT.cloud.orgId="";ROOT.cloud.members=[];ROOT.cloud.stores=[];persistRoot();
+    throw e;
+  }
+}
+async function cloudRequest(path,{method="GET",body=null,auth=true,headers={}}={}){
+  if(!cloudConfigured())throw new Error("Supabase設定が未完了です。");
+  if(auth)await cloudEnsureFreshSession();
+  const c=ROOT.cloud,url=cloudSanitizeProjectUrl(c.projectUrl)+path;
+  const h={"apikey":c.publicKey,"Content-Type":"application/json",...headers};
+  if(auth&&c.session?.access_token)h.Authorization=`Bearer ${c.session.access_token}`;
+  const opts={method,headers:h};
+  if(body!==null)opts.body=JSON.stringify(body);
+  const r=await fetch(url,opts);
+  const txt=await r.text();let data=null;try{data=txt?JSON.parse(txt):null}catch{data=txt}
+  if(!r.ok)throw new Error(data?.message||data?.error_description||data?.error||data?.details||`HTTP ${r.status}: ${txt.slice(0,240)}`);
+  return data;
+}
+async function cloudAudit(action,entityType,entityKey="",detail={}){
+  try{
+    if(!ROOT.cloud?.orgId||!cloudLoggedIn())return;
+    await cloudRequest("/rest/v1/cloud_audit",{method:"POST",body:{
+      org_id:ROOT.cloud.orgId,
+      user_id:ROOT.cloud.session?.user?.id,
+      action,entity_type:entityType,entity_key:String(entityKey||""),
+      detail
+    },headers:{"Prefer":"return=minimal"}});
+  }catch(_){}
+}
+function cloudRandomCode(){
+  const chars="ABCDEFGHJKLMNPQRSTUVWXYZ23456789",a=new Uint8Array(8);crypto.getRandomValues(a);
+  const s=[...a].map(x=>chars[x%chars.length]).join("");return `${s.slice(0,4)}-${s.slice(4)}`;
+}
+async function cloudEnsureDirectory(displayName=""){
+  await cloudEnsureFreshSession();
+  const user=ROOT.cloud.session.user||await cloudRequest("/auth/v1/user");
+  ROOT.cloud.session.user=user;
+  const rows=await cloudRequest(`/rest/v1/user_directory?user_id=eq.${encodeURIComponent(user.id)}&select=user_id,display_name,join_code&limit=1`);
+  let row=Array.isArray(rows)?rows[0]:null;
+  const name=String(displayName||row?.display_name||activeProfile()?.name||"利用者").trim();
+  if(row){
+    if(displayName&&name!==row.display_name){
+      const updated=await cloudRequest(`/rest/v1/user_directory?user_id=eq.${encodeURIComponent(user.id)}`,{method:"PATCH",body:{display_name:name,updated_at:new Date().toISOString()},headers:{"Prefer":"return=representation"}});
+      row=updated?.[0]||{...row,display_name:name};
+    }
+  }else{
+    let lastErr=null;
+    for(let i=0;i<5;i++){
+      const code=cloudRandomCode();
+      try{
+        const created=await cloudRequest("/rest/v1/user_directory",{method:"POST",body:{user_id:user.id,display_name:name,join_code:code},headers:{"Prefer":"return=representation"}});
+        row=created?.[0];lastErr=null;break;
+      }catch(e){lastErr=e;if(!String(e.message||e).includes("user_directory_join_code_key"))throw e}
+    }
+    if(!row)throw lastErr||new Error("登録コードを作成できませんでした。");
+  }
+  ROOT.cloud.directoryName=row.display_name||name;
+  ROOT.cloud.userCode=row.join_code||"";
+  persistRoot();
+  return row;
+}
+async function cloudSignUp(){
+  const email=$("#cloudEmail")?.value.trim(),password=$("#cloudPassword")?.value||"";
+  if(!email||!email.includes("@")){alert("メールアドレスを入力してください。");return}
+  if(password.length<8){alert("パスワードは8文字以上にしてください。");return}
+  try{
+    const data=await cloudAuthRaw("/auth/v1/signup",{email,password});
+    if(cloudStoreSession(data)){
+      await cloudLoadContext({silent:true});alert("アカウントを作成してログインしました。");
+    }else{
+      alert("アカウントを作成しました。Supabaseから届く確認メールのリンクを開いてからログインしてください。");
+    }
+  }catch(e){alert(cloudErrorMessage(e))}
+  render();
+}
+async function cloudSignIn(){
+  const email=$("#cloudEmail")?.value.trim(),password=$("#cloudPassword")?.value||"";
+  if(!email||!password){alert("メールアドレスとパスワードを入力してください。");return}
+  try{
+    const data=await cloudAuthRaw("/auth/v1/token?grant_type=password",{email,password});
+    if(!cloudStoreSession(data))throw new Error("ログイン情報を取得できませんでした。");
+    await cloudLoadContext({silent:true});alert("クラウドへログインしました。");
+  }catch(e){alert(cloudErrorMessage(e))}
+  render();
+}
+async function cloudSignOut(){
+  try{if(cloudLoggedIn())await cloudRequest("/auth/v1/logout",{method:"POST",body:{}})}catch(_){}
+  ROOT.cloud={...normalizeCloud(ROOT.cloud),session:null,orgId:"",orgName:"",role:"",storeId:"",storeName:"",displayName:"",directoryName:"",userCode:"",stores:[],members:[],lastContextAt:""};
+  persistRoot();render();
+}
+async function cloudLoadContext({silent=false}={}){
+  try{
+    const user=await cloudRequest("/auth/v1/user");
+    ROOT.cloud.session.user=user;
+    const dirRows=await cloudRequest(`/rest/v1/user_directory?user_id=eq.${encodeURIComponent(user.id)}&select=user_id,display_name,join_code&limit=1`);
+    const dir=Array.isArray(dirRows)?dirRows[0]:null;
+    ROOT.cloud.directoryName=dir?.display_name||"";
+    ROOT.cloud.userCode=dir?.join_code||"";
+    const memberRows=await cloudRequest(`/rest/v1/org_members?user_id=eq.${encodeURIComponent(user.id)}&select=org_id,user_id,role,store_id,display_name,joined_at,updated_at&limit=1`);
+    const m=Array.isArray(memberRows)?memberRows[0]:null;
+    if(!m){
+      ROOT.cloud.orgId="";ROOT.cloud.orgName="";ROOT.cloud.role="";ROOT.cloud.storeId="";ROOT.cloud.storeName="";
+      ROOT.cloud.displayName="";ROOT.cloud.stores=[];ROOT.cloud.members=[];ROOT.cloud.remoteMasterVersion=0;ROOT.cloud.remoteMasterUpdatedAt="";
+      ROOT.cloud.lastContextAt=new Date().toISOString();persistRoot();if(!silent)render();return;
+    }
+    const orgRows=await cloudRequest(`/rest/v1/organizations?id=eq.${encodeURIComponent(m.org_id)}&select=id,name,created_at&limit=1`);
+    const stores=await cloudRequest(`/rest/v1/stores?org_id=eq.${encodeURIComponent(m.org_id)}&select=id,name,active,created_at&order=name.asc`);
+    const members=await cloudRequest(`/rest/v1/org_members?org_id=eq.${encodeURIComponent(m.org_id)}&select=org_id,user_id,role,store_id,display_name,joined_at,updated_at&order=joined_at.asc`);
+    const meta=await cloudRequest(`/rest/v1/shared_master?org_id=eq.${encodeURIComponent(m.org_id)}&select=master_version,updated_at,updated_by&limit=1`);
+    ROOT.cloud.orgId=m.org_id;
+    ROOT.cloud.orgName=orgRows?.[0]?.name||"";
+    ROOT.cloud.role=m.role||"";
+    ROOT.cloud.storeId=m.store_id||"";
+    ROOT.cloud.displayName=m.display_name||"";
+    ROOT.cloud.stores=Array.isArray(stores)?stores:[];
+    ROOT.cloud.storeName=cloudStoreName(m.store_id);
+    ROOT.cloud.members=Array.isArray(members)?members:[];
+    ROOT.cloud.remoteMasterVersion=+(meta?.[0]?.master_version||0);
+    ROOT.cloud.remoteMasterUpdatedAt=meta?.[0]?.updated_at||"";
+    ROOT.cloud.lastContextAt=new Date().toISOString();
+    persistRoot();if(!silent)render();
+  }catch(e){
+    if(!silent)alert(cloudErrorMessage(e));
+    throw e;
+  }
+}
+async function cloudCreateUserCode(){
+  const display=$("#cloudDirectoryName")?.value.trim();
+  if(!display){alert("表示名を入力してください。");return}
+  try{
+    await cloudEnsureDirectory(display);render();alert("利用者登録コードを作成しました。管理者へこのコードを伝えてください。");
+  }catch(e){alert(cloudErrorMessage(e))}
+}
+async function cloudCreateOrg(){
+  const company=$("#cloudCompanyName")?.value.trim(),storeName=$("#cloudFirstStore")?.value.trim(),display=$("#cloudDisplayName")?.value.trim();
+  if(!company||!display){alert("会社名と表示名を入力してください。");return}
+  try{
+    const dir=await cloudEnsureDirectory(display),user=ROOT.cloud.session.user;
+    const orgRows=await cloudRequest("/rest/v1/organizations",{method:"POST",body:{name:company,created_by:user.id},headers:{"Prefer":"return=representation"}});
+    const org=orgRows?.[0];if(!org?.id)throw new Error("会社を作成できませんでした。");
+    await cloudRequest("/rest/v1/org_members",{method:"POST",body:{org_id:org.id,user_id:user.id,role:"owner",store_id:null,display_name:dir.display_name},headers:{"Prefer":"return=representation"}});
+    let store=null;
+    if(storeName){
+      const stores=await cloudRequest("/rest/v1/stores",{method:"POST",body:{org_id:org.id,name:storeName},headers:{"Prefer":"return=representation"}});
+      store=stores?.[0]||null;
+      if(store?.id){
+        await cloudRequest(`/rest/v1/org_members?org_id=eq.${encodeURIComponent(org.id)}&user_id=eq.${encodeURIComponent(user.id)}`,{method:"PATCH",body:{store_id:store.id,updated_at:new Date().toISOString()},headers:{"Prefer":"return=representation"}});
+      }
+    }
+    await cloudLoadContext({silent:true});await cloudAudit("create","organization",org.id,{name:company,store:storeName||""});
+    alert("会社を作成しました。あなたはオーナーです。");render();
+  }catch(e){alert(cloudErrorMessage(e))}
+}
+async function cloudAddMemberDialog(){
+  if(!cloudIsAdminRole()){alert("オーナーまたは管理者だけが利用者を追加できます。");return}
+  const stores=ROOT.cloud.stores||[];
+  modal(`<h2>クラウド利用者を追加</h2>
+    <p class="muted">本人の「利用者登録コード」を入力してください。</p>
+    <div class="field"><label>登録コード</label><input id="cloudAddCode" placeholder="ABCD-EFGH"></div>
+    <div class="field"><label>権限</label><select id="cloudAddRole"><option value="orderer">発注担当</option><option value="manager">店長</option><option value="viewer">閲覧のみ</option>${ROOT.cloud.role==="owner"?'<option value="admin">管理者</option>':""}</select></div>
+    <div class="field"><label>所属店舗</label><select id="cloudAddStore"><option value="">店舗未指定</option>${stores.map(s=>`<option value="${esc(s.id)}">${esc(s.name)}</option>`).join("")}</select></div>
+    <button class="btn full" id="cloudAddMemberSave">利用者を追加</button>`);
+  $("#cloudAddMemberSave").onclick=async()=>{
+    const code=String($("#cloudAddCode").value||"").trim().toUpperCase(),role=$("#cloudAddRole").value,storeId=$("#cloudAddStore").value||null;
+    if(!code){alert("登録コードを入力してください。");return}
+    try{
+      const rows=await cloudRequest(`/rest/v1/user_directory?join_code=eq.${encodeURIComponent(code)}&select=user_id,display_name,join_code&limit=1`);
+      const target=rows?.[0];if(!target){alert("登録コードが見つかりません。本人にコードを確認してください。");return}
+      await cloudRequest("/rest/v1/org_members",{method:"POST",body:{org_id:ROOT.cloud.orgId,user_id:target.user_id,role,store_id:storeId,display_name:target.display_name},headers:{"Prefer":"return=representation"}});
+      await cloudAudit("create","member",target.user_id,{role,store_id:storeId,display_name:target.display_name});
+      $("#modal").close();await cloudLoadContext({silent:true});alert(`${target.display_name} を追加しました。`);render();
+    }catch(e){alert(cloudErrorMessage(e))}
+  };
+}
+async function cloudAddStore(){
+  if(!cloudIsAdminRole()){alert("オーナーまたは管理者だけが店舗を追加できます。");return}
+  const name=prompt("追加する店舗名を入力してください。");
