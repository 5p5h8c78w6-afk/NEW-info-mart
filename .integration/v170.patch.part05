+function backupSafeRoot(){const r=clone(ROOT);r.cloud=cloudDefault();return r}
+function exportAllJson(){ROOT.lastExportAt=new Date().toISOString();persistRoot();downloadJson({type:"infomartOrderNav.multiuser",schemaVersion:SCHEMA_VERSION,exportedAt:ROOT.lastExportAt,root:backupSafeRoot()},`InfomartOrder_ALL_USERS_${iso(today())}.json`);render()}
