+  if(!name?.trim())return;
+  try{
+    const rows=await cloudRequest("/rest/v1/stores",{method:"POST",body:{org_id:ROOT.cloud.orgId,name:name.trim()},headers:{"Prefer":"return=representation"}});
+    await cloudAudit("create","store",rows?.[0]?.id||"",{name:name.trim()});
+    await cloudLoadContext({silent:true});alert("店舗を追加しました。");render();
+  }catch(e){alert(cloudErrorMessage(e))}
+}
+function cloudMemberDialog(userId){
+  const m=(ROOT.cloud.members||[]).find(x=>x.user_id===userId);if(!m)return;
+  if(!cloudIsAdminRole()){alert("オーナーまたは管理者だけが権限を変更できます。");return}
+  const stores=ROOT.cloud.stores||[];
+  const roleOptions=["owner","admin","manager","orderer","viewer"].filter(r=>ROOT.cloud.role==="owner"||r!=="owner");
+  modal(`<h2>利用者を編集</h2>
+    <div class="field"><label>表示名</label><input id="cloudMemberName" value="${esc(m.display_name||"")}"></div>
+    <div class="field"><label>権限</label><select id="cloudMemberRole">${roleOptions.map(r=>`<option value="${r}" ${m.role===r?"selected":""}>${esc(cloudRoleLabel(r))}</option>`).join("")}</select></div>
+    <div class="field"><label>所属店舗</label><select id="cloudMemberStore"><option value="">店舗未指定</option>${stores.map(s=>`<option value="${esc(s.id)}" ${m.store_id===s.id?"selected":""}>${esc(s.name)}</option>`).join("")}</select></div>
+    <button class="btn full" id="cloudMemberSave">保存</button>`);
+  $("#cloudMemberSave").onclick=async()=>{
+    const display=$("#cloudMemberName").value.trim(),role=$("#cloudMemberRole").value,storeId=$("#cloudMemberStore").value||null;
+    if(!display){alert("表示名を入力してください。");return}
+    try{
+      const rows=await cloudRequest(`/rest/v1/org_members?org_id=eq.${encodeURIComponent(ROOT.cloud.orgId)}&user_id=eq.${encodeURIComponent(m.user_id)}`,{method:"PATCH",body:{role,store_id:storeId,display_name:display,updated_at:new Date().toISOString()},headers:{"Prefer":"return=representation"}});
+      if(!rows?.length)throw new Error("権限更新がクラウド側で拒否されました。");
+      await cloudAudit("update","member",m.user_id,{role,store_id:storeId,display_name:display});
+      $("#modal").close();await cloudLoadContext({silent:true});alert("利用者設定を更新しました。");render();
+    }catch(e){alert(cloudErrorMessage(e))}
+  };
+}
+async function cloudRemoteMasterRow(includePayload=false){
+  const select=includePayload?"master_version,payload,updated_at,updated_by":"master_version,updated_at,updated_by";
+  const rows=await cloudRequest(`/rest/v1/shared_master?org_id=eq.${encodeURIComponent(ROOT.cloud.orgId)}&select=${encodeURIComponent(select)}&limit=1`);
+  return Array.isArray(rows)?rows[0]||null:null;
+}
+async function cloudDownloadMaster(){
+  if(!ROOT.cloud.orgId){alert("会社への登録が必要です。");return}
+  try{
+    const row=await cloudRemoteMasterRow(true);
+    if(!row){alert("クラウドにはまだ共通マスターがありません。オーナーまたは管理者が最初にアップロードしてください。");return}
+    const checked=validateMasterPackage(row.payload);
+    if(!checked.products.length&&!confirm("クラウド共通マスターの商品数が0件です。取得を続けますか？"))return;
+    if(!confirm(`クラウド共通マスター v${row.master_version} を取得します。\nローカルの共通マスターを置き換えますが、個人数量・プリセット・履歴は保持します。続けますか？`))return;
+    const pkg={...row.payload,masterVersion:+row.payload?.masterVersion||ROOT.masterVersion||1};
+    applyMasterPackage(pkg,{reason:"クラウド共通マスター取得"});
+    ROOT.cloud.lastMasterVersion=+row.master_version||0;
+    ROOT.cloud.remoteMasterVersion=+row.master_version||0;
+    ROOT.cloud.remoteMasterUpdatedAt=row.updated_at||"";
+    ROOT.cloud.lastSyncAt=new Date().toISOString();
+    persistRoot();render();alert("クラウドの共通マスターを取得しました。");
+  }catch(e){alert(cloudErrorMessage(e))}
+}
+async function cloudUploadMaster(){
+  if(!ROOT.cloud.orgId){alert("会社への登録が必要です。");return}
+  if(!cloudIsAdminRole()){alert("共通マスターをクラウドへ保存できるのはオーナーまたは管理者だけです。");return}
+  try{
+    const remote=await cloudRemoteMasterRow(false),remoteVersion=+(remote?.master_version||0),known=+(ROOT.cloud.lastMasterVersion||0);
+    ROOT.cloud.remoteMasterVersion=remoteVersion;ROOT.cloud.remoteMasterUpdatedAt=remote?.updated_at||"";
+    if(remoteVersion!==known&&remoteVersion>0){
+      persistRoot();render();
+      alert(`クラウド側が v${remoteVersion} へ更新されています。\n事故防止のため上書きしません。先に「クラウドから取得」を実行してください。`);
+      return;
+    }
+    if(!ROOT.commonMaster.products.length&&!confirm("ローカル共通マスターの商品数が0件です。本当にクラウドへ保存しますか？"))return;
+    if(!confirm(`ローカル共通マスターをクラウドへ保存します。\n現在のクラウド版：v${remoteVersion}\n続けますか？`))return;
+    const userId=ROOT.cloud.session?.user?.id,payload=commonMasterPackage(),next=remoteVersion+1;
+    let rows;
+    if(remoteVersion===0){
+      rows=await cloudRequest("/rest/v1/shared_master",{method:"POST",body:{org_id:ROOT.cloud.orgId,master_version:1,payload,updated_at:new Date().toISOString(),updated_by:userId},headers:{"Prefer":"return=representation"}});
+    }else{
+      rows=await cloudRequest(`/rest/v1/shared_master?org_id=eq.${encodeURIComponent(ROOT.cloud.orgId)}&master_version=eq.${remoteVersion}`,{method:"PATCH",body:{master_version:next,payload,updated_at:new Date().toISOString(),updated_by:userId},headers:{"Prefer":"return=representation"}});
+      if(!rows?.length)throw new Error("version_conflict");
+    }
+    const row=rows?.[0],newVersion=+(row?.master_version||next);
+    ROOT.cloud.lastMasterVersion=newVersion;ROOT.cloud.remoteMasterVersion=newVersion;
+    ROOT.cloud.remoteMasterUpdatedAt=row?.updated_at||new Date().toISOString();ROOT.cloud.lastSyncAt=new Date().toISOString();
+    persistRoot();await cloudAudit("sync","shared_master",ROOT.cloud.orgId,{version:newVersion});
+    render();alert(`共通マスターをクラウド v${newVersion} として保存しました。`);
+  }catch(e){alert(cloudErrorMessage(e))}
+}
+async function cloudCheckLatest(){
+  try{
+    await cloudLoadContext({silent:true});
+    const r=ROOT.cloud.remoteMasterVersion||0,l=ROOT.cloud.lastMasterVersion||0;
+    render();
+    if(!r)alert("クラウド共通マスターはまだありません。");
+    else if(r>l)alert(`クラウドに新しい共通マスター v${r} があります。`);
+    else alert(`クラウド共通マスターは確認済みです。クラウド v${r} / この端末の最終同期 v${l}`);
+  }catch(e){alert(cloudErrorMessage(e))}
+}
+function cloudMemberRows(){
+  const members=ROOT.cloud.members||[];
+  if(!members.length)return '<p class="muted">利用者情報をまだ取得していません。</p>';
+  return `<div class="cloud-member-list">${members.map(m=>`<div class="cloud-member-row"><div><strong>${esc(m.display_name||"名称なし")}</strong><br><span class="muted">${esc(cloudRoleLabel(m.role))}${m.store_id?` / ${esc(cloudStoreName(m.store_id)||"店舗不明")}`:" / 店舗未指定"}</span></div>${cloudIsAdminRole()?`<button class="btn secondary small" data-cloud-member="${esc(m.user_id)}">編集</button>`:""}</div>`).join("")}</div>`;
+}
+function cloudPage(){
+  const c=ROOT.cloud||cloudDefault(),configured=cloudConfigured(),logged=cloudLoggedIn(),joined=!!c.orgId;
+  const email=c.session?.user?.email||"",remote=+c.remoteMasterVersion||0,last=+c.lastMasterVersion||0;
+  return `<button class="btn secondary small" data-nav="home">← ホーム</button>
+  <div class="section page-title-row"><div>クラウド同期・利用者管理</div><span class="version-chip">無料ルート</span></div>
+  <section class="card cloud-free-card"><h3>GitHub Pages + Supabase Free</h3><p>現在の発注ナビを残したまま、<strong>会社・店舗・利用者権限・共通商品マスター</strong>をクラウド化します。</p><div class="success"><strong>まず無料枠だけで運用します。</strong></div></section>
+  <section class="card"><h3>① Supabase Free 接続設定</h3>
+    <ol class="cloud-steps"><li>SupabaseでFreeプロジェクトを1つ作成</li><li>SQL EditorでセットアップSQLを1回実行</li><li>Project URL と Publishable key を入力</li></ol>
+    <div class="grid2"><a class="btn secondary cloud-link" href="https://supabase.com/dashboard" target="_blank" rel="noopener">Supabaseを開く</a><button class="btn secondary" id="cloudCopySql">セットアップSQLをコピー</button></div>
+    <div class="field"><label>Project URL</label><input id="cloudProjectUrl" value="${esc(c.projectUrl||"")}" placeholder="https://xxxx.supabase.co"></div>
+    <div class="field"><label>Publishable key</label><input id="cloudPublicKey" value="${esc(c.publicKey||"")}" placeholder="sb_publishable_..."><span class="help">新しいPublishable keyを推奨。旧形式のanon keyも判別して利用できます。</span></div>
+    <div class="error"><strong>Secret key / service_role key は絶対に入力しないでください。</strong> ブラウザ側では公開用Publishable keyだけを使います。</div>
+    <button class="btn full" id="cloudSaveConfig">接続設定を保存</button>
+    <p class="muted">接続設定はこの端末だけに保存され、GitHubへはアップロードされません。</p>
+  </section>
+  ${configured?(!logged?`<section class="card"><h3>② クラウドアカウント</h3>
+    <div class="field"><label>メールアドレス</label><input id="cloudEmail" type="email" autocomplete="username"></div>
+    <div class="field"><label>パスワード</label><input id="cloudPassword" type="password" autocomplete="current-password"><span class="help">8文字以上。</span></div>
+    <div class="grid2"><button class="btn" id="cloudSignIn">ログイン</button><button class="btn secondary" id="cloudSignUp">新規登録</button></div>
+    <p class="muted">Supabaseの初期設定では確認メールが有効です。新規登録後、メール内リンクを開いてからログインします。</p>
+  </section>`:`<section class="card"><h3>② ログイン中</h3><p><strong>${esc(email||"クラウド利用者")}</strong></p><button class="btn secondary full" id="cloudSignOut">ログアウト</button></section>
+  ${!joined?`<section class="card"><h3>③ 会社を作る / 会社へ登録してもらう</h3>
+    <div class="cloud-split">
+      <div><h4>最初の管理者</h4><div class="field"><label>会社名</label><input id="cloudCompanyName" placeholder="例：株式会社○○"></div><div class="field"><label>最初の店舗</label><input id="cloudFirstStore" placeholder="例：たまプラーザ店"></div><div class="field"><label>あなたの表示名</label><input id="cloudDisplayName" value="${esc(c.directoryName||activeProfile()?.name||"")}" placeholder="例：小泉"></div><button class="btn full" id="cloudCreateOrg">会社を作る</button></div>
+      <div><h4>既存会社の利用者</h4>${c.userCode?`<p>管理者へこのコードを伝えてください。</p><div class="cloud-invite-code">${esc(c.userCode)}</div><button class="btn secondary full" id="cloudCopyUserCode">登録コードをコピー</button><button class="btn full" id="cloudRefresh" style="margin-top:8px">管理者登録後に再読み込み</button>`:`<div class="field"><label>あなたの表示名</label><input id="cloudDirectoryName" value="${esc(c.directoryName||activeProfile()?.name||"")}" placeholder="例：佐藤"></div><button class="btn full" id="cloudCreateUserCode">利用者登録コードを作る</button>`}<p class="muted">本人が会社へ勝手に参加できない方式です。管理者がコードを確認して追加します。</p></div>
+    </div>
+  </section>`:`<section class="card cloud-org-card"><h3>③ 会社・店舗</h3><div class="cloud-org-grid"><div><span>会社</span><strong>${esc(c.orgName||"")}</strong></div><div><span>店舗</span><strong>${esc(c.storeName||"未指定")}</strong></div><div><span>表示名</span><strong>${esc(c.displayName||"")}</strong></div><div><span>権限</span><strong>${esc(cloudRoleLabel(c.role))}</strong></div></div><button class="btn secondary full" id="cloudRefresh">最新情報を取得</button></section>
+  <section class="card"><h3>共通商品マスター同期</h3><div class="cloud-version-grid"><div><span>クラウド</span><strong>v${remote}</strong></div><div><span>この端末の最終同期</span><strong>v${last}</strong></div><div><span>ローカル共通マスター</span><strong>v${ROOT.masterVersion||1}</strong></div></div>
+    ${remote>last?'<div class="notice"><strong>クラウドに新しいマスターがあります。</strong> 先にクラウドから取得してください。</div>':""}
+    <div class="grid2"><button class="btn" id="cloudDownloadMaster">クラウドから取得</button><button class="btn secondary" id="cloudCheckLatest">最新版を確認</button></div>
+    ${cloudIsAdminRole()?'<div style="height:8px"></div><button class="btn green full" id="cloudUploadMaster">管理者：クラウドへ保存</button>':'<p class="muted">クラウドへの保存はオーナー / 管理者だけです。</p>'}
+    <p class="muted">v1.7.0の同期対象は共通商品・発注先。個人数量、プリセット、履歴は端末保存のままです。</p>
+  </section>
+  <section class="card"><div class="page-title-row"><h3>利用者</h3>${cloudIsAdminRole()?'<button class="btn secondary small" id="cloudAddMember">利用者を追加</button>':""}</div>${cloudMemberRows()}</section>
+  ${cloudIsAdminRole()?`<section class="card"><h3>店舗管理</h3><p>${(c.stores||[]).map(s=>`<span class="badge">${esc(s.name)}</span>`).join(" ")||"店舗なし"}</p><button class="btn secondary full" id="cloudAddStore">店舗を追加</button></section>`:""}`}`):""}`;
+}
+
 function settings(){
   const h=healthStatus(),sn=getSnapshots();
   return `<button class="btn secondary small" data-nav="home">← ホーム</button><div class="section">設定・保守</div>
   <section class="card"><h3>利用者</h3><p><strong>${esc(activeProfile().name)}</strong></p><button class="btn secondary full" id="manageUsers">利用者を切り替え・追加</button></section>
